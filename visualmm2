local function createEspFullButton()
    local espButton = Instance.new("TextButton")
    espButton.Size = UDim2.new(1, -40, 0, 25)
    espButton.Position = UDim2.new(0, 10, 0, 65)
    espButton.BackgroundColor3 = Color3.new(0.2, 0.2, 0.8)
    espButton.BorderSizePixel = 0
    espButton.Text = "🔍 Full ESP (OFF)"
    espButton.TextColor3 = Color3.new(1, 1, 1)
    espButton.TextScaled = true
    espButton.Font = Enum.Font.GothamBold
    espButton.Parent = mainFrame

    local espCorner = Instance.new("UICorner")
    espCorner.CornerRadius = UDim.new(0, 8)
    espCorner.Parent = espButton

    local espGradient = Instance.new("UIGradient")
    espGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.new(0.3, 0.3, 0.9)),
        ColorSequenceKeypoint.new(1, Color3.new(0.1, 0.1, 0.7))
    }
    espGradient.Rotation = 90
    espGradient.Parent = espButton

    local function animateEspButton(action)
        if action == "click" then
            TweenService:Create(espButton, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.InOut), {Size = UDim2.new(1, -45, 0, 20)}):Play()
            wait(0.1)
            TweenService:Create(espButton, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(1, -40, 0, 25)}):Play()
        end
    end

    local function updateEspForPlayer(p)
        if p == player or not p.Character then return end
        local knife = p.Backpack:FindFirstChild("Knife") or p.Character:FindFirstChild("Knife")
        local gun = p.Backpack:FindFirstChild("Gun") or p.Character:FindFirstChild("Gun")
        local roleColor = knife and Color3.new(1, 0, 0) or gun and Color3.new(0, 0.5, 1) or Color3.new(0, 1, 0)
        if espHighlights[p] then espHighlights[p]:Destroy() end
        local highlight = Instance.new("Highlight")
        highlight.Adornee = p.Character
        highlight.FillTransparency = 1
        highlight.OutlineColor = roleColor
        highlight.OutlineTransparency = 0
        highlight.Parent = p.Character
        espHighlights[p] = highlight
    end

    local function espLoop()
        if not isMM2 then
            espButton.Text = "🔍 Full ESP (Not MM2)"
            return
        end
        for _, p in pairs(Players:GetPlayers()) do
            updateEspForPlayer(p)
        end
    end

    espButton.MouseButton1Click:Connect(function()
        isEspFull = not isEspFull
        if isEspFull then
            espConnection = RunService.Heartbeat:Connect(espLoop)
            espButton.Text = "🔍 Full ESP (ON)"
            espButton.BackgroundColor3 = Color3.new(0.2, 0.8, 0.2)
            espGradient.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.new(0.3, 0.9, 0.3)),
                ColorSequenceKeypoint.new(1, Color3.new(0.1, 0.7, 0.1))
            }
        else
            if espConnection then espConnection:Disconnect() espConnection = nil end
            for _, highlight in pairs(espHighlights) do if highlight then highlight:Destroy() end end
            espHighlights = {}
            espButton.Text = "🔍 Full ESP (OFF)"
            espButton.BackgroundColor3 = Color3.new(0.2, 0.2, 0.8)
            espGradient.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.new(0.3, 0.3, 0.9)),
                ColorSequenceKeypoint.new(1, Color3.new(0.1, 0.1, 0.7))
            }
        end
        animateEspButton("click")
    end)

    return espButton
end

-- Функция для Shoot Murderer (обновленная версия для MM2 ноября 2025)
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

local function createShootMurderButton()
    local shootButton = Instance.new("TextButton")
    shootButton.Size = UDim2.new(1, -40, 0, 25)
    shootButton.Position = UDim2.new(0, 10, 0, 95)
    shootButton.BackgroundColor3 = Color3.new(0.8, 0.2, 0.2)
    shootButton.BorderSizePixel = 0
    shootButton.Text = "🔫 Shoot Murderer"
    shootButton.TextColor3 = Color3.new(1, 1, 1)
    shootButton.TextScaled = true
    shootButton.Font = Enum.Font.GothamBold
    shootButton.Parent = mainFrame
    local shootCorner = Instance.new("UICorner")
    shootCorner.CornerRadius = UDim.new(0, 8)
    shootCorner.Parent = shootButton
    local shootGradient = Instance.new("UIGradient")
    shootGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.new(0.9, 0.3, 0.3)),
        ColorSequenceKeypoint.new(1, Color3.new(0.7, 0.1, 0.1))
    }
    shootGradient.Rotation = 90
    shootGradient.Parent = shootButton
    
    local function animateShootButton(action)
        if action == "click" then
            local shrinkTween = TweenService:Create(shootButton, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.InOut), {Size = UDim2.new(1, -45, 0, 20)})
            shrinkTween:Play()
            shrinkTween.Completed:Wait()
            local expandTween = TweenService:Create(shootButton, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(1, -40, 0, 25)})
            expandTween:Play()
        end
    end
    
    local function grabGunIfNeeded()
        print("=== DEBUG: Проверяем наличие Gun ===")
        local gun = workspace:FindFirstChild("Gun", true) -- Ищем Gun в workspace (включая модели)
        if gun and gun:IsA("Tool") then
            print("✅ Gun найден в мире, телепортируем к себе...")
            local character = player.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                gun.Handle.CFrame = character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -2) -- Телепорт к ногам
                task.wait(0.5)
                gun.Parent = player.Backpack -- Перемещаем в инвентарь
                print("✅ Gun забран!")
                return true
            end
        else
            print("❌ Gun не найден в мире.")
        end
        return false
    end
    
    local function shootAtMurderer()
        print("=== DEBUG: Запуск shootAtMurderer (2025 версия) ===")
        if not isMM2 then
            print("❌ Это не MM2!")
            return false
        end
       
        local character = player.Character
        if not character then
            print("❌ Нет персонажа!")
            return false
        end
        print("✅ Персонаж найден")
        
        -- Авто-захват Gun если нет
        local gun = player.Backpack:FindFirstChild("Gun") or character:FindFirstChild("Gun")
        if not gun then
            local grabbed = grabGunIfNeeded()
            if grabbed then
                gun = player.Backpack:FindFirstChild("Gun")
            end
        end
        if not gun then
            print("❌ Нет Gun! Авто-захват не сработал. Вы не шериф или Gun не спавнился.")
            return false
        end
        print("✅ Gun найден в " .. gun.Parent.Name)
        
        -- Ищем Murderer
        local murderer = findMurderer()
        if not murderer or not murderer.Character then
            print("❌ Murderer не найден! Проверьте функцию findMurderer().")
            return false
        end
        print("✅ Murderer найден: " .. murderer.Name)
        
        local murdererRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
        local myRoot = character:FindFirstChild("HumanoidRootPart")
        if not murdererRoot or not myRoot then
            print("❌ Нет HumanoidRootPart!")
            return false
        end
        print("✅ RootPart найдены")
        
        -- Дистанция (увеличена до 150 для 2025)
        local distance = (murdererRoot.Position - myRoot.Position).Magnitude
        print("📏 Дистанция: " .. math.floor(distance) .. " studs")
        if distance > 150 then
            print("❌ Murderer слишком далеко!")
            return false
        end
        
        -- Экипировка Gun
        if gun.Parent == player.Backpack then
            print("🔄 Экипируем Gun...")
            gun.Parent = character
            task.wait(0.6) -- Задержка для экипировки (MM2 2025 может требовать больше)
            print("✅ Gun экипирован")
        end
        
        -- Поворот (используем BodyGyro для избежания флагов античита)
        local bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(400000, 400000, 400000)
        bodyGyro.P = 20000
        bodyGyro.Parent = myRoot
        local targetCFrame = CFrame.lookAt(myRoot.Position, murdererRoot.Position)
        bodyGyro.CFrame = targetCFrame
        print("🔄 Поворот к цели (BodyGyro)")
        
        task.wait(0.4) -- Синхронизация
        
        -- МЕТОД 1: Активация Gun (стандарт для шерифа)
        print("🔫 Метод 1: Активация Gun...")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local success, err = pcall(function()
            if gun:IsA("Tool") then
                gun:Activate()
                task.wait(0.15) -- Короткая пауза для выстрела
            end
        end)
        if success then
            print("✅ Gun активирован!")
            bodyGyro:Destroy()
            return true
        else
            warn("Ошибка активации: " .. tostring(err))
        end
        
        -- МЕТОД 2: MainEvent Hit (обновлено для 2025)
        print("🔫 Метод 2: MainEvent Hit...")
        local mainRemote = ReplicatedStorage:FindFirstChild("MainEvent")
        if mainRemote then
            local success, err = pcall(function()
                mainRemote:FireServer("Hit", murderer, "Head") -- Стандарт: "Hit", player, bodyPart
            end)
            if success then
                print("✅ Hit через MainEvent!")
                bodyGyro:Destroy()
                return true
            else
                warn("Ошибка MainEvent: " .. tostring(err))
            end
        else
            print("❌ MainEvent не найден")
        end
        
        -- МЕТОД 3: Gun Remote (если есть)
        print("🔫 Метод 3: Gun Remote...")
        local gunRemote = gun:FindFirstChild("RemoteEvent") or gun:FindFirstChildOfClass("RemoteEvent")
        if gunRemote then
            local success, err = pcall(function()
                gunRemote:FireServer("Head") -- Или пусто: gunRemote:FireServer()
            end)
            if success then
                print("✅ Hit через Gun Remote!")
                bodyGyro:Destroy()
                return true
            else
                warn("Ошибка Gun Remote: " .. tostring(err))
            end
        end
        
        bodyGyro:Destroy()
        print("❌ Все методы провалились! Проверьте:")
        print("- Роль: Шериф? Gun спавнился?")
        print("- Дистанция <150 studs")
        print("- Shift Lock включен в настройках MM2?")
        print("- Экипируйте Gun вручную и попробуйте клик мыши.")
        return false
    end
    
    shootButton.MouseButton1Click:Connect(function()
        animateShootButton("click")
        
        task.spawn(function()
            local success = shootAtMurderer()
            if success then
                shootButton.Text = "🔫 Shot Fired!"
                shootButton.BackgroundColor3 = Color3.new(0.2, 0.8, 0.2)
                task.wait(2)
                shootButton.Text = "🔫 Shoot Murderer"
                shootButton.BackgroundColor3 = Color3.new(0.8, 0.2, 0.2)
            else
                shootButton.Text = "🔫 Failed!"
                shootButton.BackgroundColor3 = Color3.new(0.5, 0.5, 0.5)
                task.wait(2)
                shootButton.Text = "🔫 Shoot Murderer"
                shootButton.BackgroundColor3 = Color3.new(0.8, 0.2, 0.2)
            end
        end)
    end)
    return shootButton
end
-- Функция для Auto Farm Coins (сохранена)
local function createAutoFarmButton()
    local autoFarmButton = Instance.new("TextButton")
    autoFarmButton.Size = UDim2.new(1, -40, 0, 25)
    autoFarmButton.Position = UDim2.new(0, 10, 0, 125)
    autoFarmButton.BackgroundColor3 = Color3.new(0.8, 0.5, 0.2)  -- Оранжевый для "off"
    autoFarmButton.BorderSizePixel = 0
    autoFarmButton.Text = "🪙 Auto Farm (OFF)"
    autoFarmButton.TextColor3 = Color3.new(1, 1, 1)
    autoFarmButton.TextScaled = true
    autoFarmButton.Font = Enum.Font.GothamBold
    autoFarmButton.Parent = mainFrame

    local autoFarmCorner = Instance.new("UICorner")
    autoFarmCorner.CornerRadius = UDim.new(0, 8)
    autoFarmCorner.Parent = autoFarmButton

    local autoFarmGradient = Instance.new("UIGradient")
    autoFarmGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.new(0.9, 0.6, 0.3)),
        ColorSequenceKeypoint.new(1, Color3.new(0.7, 0.4, 0.1))
    }
    autoFarmGradient.Rotation = 90
    autoFarmGradient.Parent = autoFarmButton

    local function animateAutoFarmButton(action)
        if action == "click" then
            TweenService:Create(autoFarmButton, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.InOut), {Size = UDim2.new(1, -45, 0, 20)}):Play()
            wait(0.1)
            TweenService:Create(autoFarmButton, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(1, -40, 0, 25)}):Play()
        end
    end

    -- Функция поиска ближайшего CoinContainer (в workspace и папках)
    local function findNearestCoinContainer()
        local character = player.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
        local rootPos = character.HumanoidRootPart.Position
        local nearestCoin = nil
        local nearestDist = math.huge
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj.Name == "CoinContainer" and obj:IsA("Model") and obj.PrimaryPart then
                local dist = (obj.PrimaryPart.Position - rootPos).Magnitude
                if dist < nearestDist and dist < 500 then
                    nearestDist = dist
                    nearestCoin = obj
                end
            end
        end
        return nearestCoin
    end

    -- Auto Farm loop
    local function autoFarmLoop()
        local character = player.Character
        if not character or not character:FindFirstChild("Humanoid") then return end
        local nearestCoin = findNearestCoinContainer()
        if nearestCoin then
            character.Humanoid:MoveTo(nearestCoin.PrimaryPart.Position)
        else
            wait(1)
        end
    end

    autoFarmButton.MouseButton1Click:Connect(function()
        local character = player.Character
        if character and character:FindFirstChild("Humanoid") then
            isAutoFarm = not isAutoFarm
            if isAutoFarm then
                autoFarmConnection = RunService.Heartbeat:Connect(autoFarmLoop)
                autoFarmButton.Text = "🪙 Auto Farm (ON)"
                autoFarmButton.BackgroundColor3 = Color3.new(0.2, 0.8, 0.2)
                autoFarmGradient.Color = ColorSequence.new{
                    ColorSequenceKeypoint.new(0, Color3.new(0.3, 0.9, 0.3)),
                    ColorSequenceKeypoint.new(1, Color3.new(0.1, 0.7, 0.1))
                }
            else
                if autoFarmConnection then autoFarmConnection:Disconnect() autoFarmConnection = nil end
                character.Humanoid:MoveTo(character.HumanoidRootPart.Position)
                autoFarmButton.Text = "🪙 Auto Farm (OFF)"
                autoFarmButton.BackgroundColor3 = Color3.new(0.8, 0.5, 0.2)
                autoFarmGradient.Color = ColorSequence.new{
                    ColorSequenceKeypoint.new(0, Color3.new(0.9, 0.6, 0.3)),
                    ColorSequenceKeypoint.new(1, Color3.new(0.7, 0.4, 0.1))
                }
            end
            animateAutoFarmButton("click")
        end
    end)

    return autoFarmButton
end

