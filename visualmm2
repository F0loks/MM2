-- Анимация для closeButton
local function animateCloseButton(action)
    local tweenInfo = TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    if action == "hover" then
        TweenService:Create(closeButton, tweenInfo, {Size = UDim2.new(0, 24, 0, 24)}):Play()
    elseif action == "unhover" then
        TweenService:Create(closeButton, tweenInfo, {Size = UDim2.new(0, 20, 0, 20)}):Play()
    elseif action == "click" then
        TweenService:Create(closeButton, TweenInfo.new(0.05, Enum.EasingStyle.Back, Enum.EasingDirection.InOut), {Size = UDim2.new(0, 16, 0, 16)}):Play()
        wait(0.05)
        TweenService:Create(closeButton, TweenInfo.new(0.05, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 20, 0, 20)}):Play()
    end
end

closeButton.MouseEnter:Connect(function() animateCloseButton("hover") end)
closeButton.MouseLeave:Connect(function() animateCloseButton("unhover") end)

closeButton.MouseButton1Click:Connect(function()
    if noclipConnection then noclipConnection:Disconnect() end
    if espConnection then espConnection:Disconnect() end
    if autoFarmConnection then autoFarmConnection:Disconnect() end
    for _, highlight in pairs(espHighlights) do if highlight then highlight:Destroy() end end
    espHighlights = {}
    animateCloseButton("click")
    screenGui:Destroy()
end)

-- Drag
local dragging = false
local dragStart = nil
local startPos = nil

local function updateInput(input)
    local delta = input.Position - dragStart
    mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                updateInput(input)
            end
        end)
    end
end)

mainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragStart = input.Position
        startPos = mainFrame.Position
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- Функция поиска Murderer
local function findMurderer()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and (p.Backpack:FindFirstChild("Knife") or p.Character and p.Character:FindFirstChild("Knife")) then
            return p
        end
    end
    return nil
end

-- Функция для Invisible (сохранена, без авто-применения)
local function createInvisibleButton()
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -40, 0, 25)
    button.Position = UDim2.new(0, 10, 0, 5)
    button.BackgroundColor3 = Color3.new(0.2, 0.4, 0.8)
    button.BorderSizePixel = 0
    button.Text = "👁️ Invisible (OFF)"
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextScaled = true
    button.Font = Enum.Font.GothamBold
    button.Parent = mainFrame

    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 8)
    buttonCorner.Parent = button

    local buttonGradient = Instance.new("UIGradient")
    buttonGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.new(0.3, 0.5, 0.9)),
        ColorSequenceKeypoint.new(1, Color3.new(0.1, 0.3, 0.7))
    }
    buttonGradient.Rotation = 90
    buttonGradient.Parent = button

    local function animateButton(action)
        if action == "click" then
            TweenService:Create(button, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.InOut), {Size = UDim2.new(1, -45, 0, 20)}):Play()
            wait(0.1)
            TweenService:Create(button, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(1, -40, 0, 25)}):Play()
        end
    end

    local function toggleTransparency(character, targetTransparency)
        if not character then return end
        local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                local tween = TweenService:Create(part, tweenInfo, {Transparency = targetTransparency})
                tween:Play()
            elseif part:IsA("Decal") then
                local tween = TweenService:Create(part, tweenInfo, {Transparency = targetTransparency})
                tween:Play()
            end
        end
    end

    button.MouseButton1Click:Connect(function()
        local character = player.Character
        if character then
            isInvisible = not isInvisible
            local targetTransparency = isInvisible and 0.7 or 0
            toggleTransparency(character, targetTransparency)
            if isInvisible then
                button.Text = "👻 Invisible (ON)"
                button.BackgroundColor3 = Color3.new(0.8, 0.2, 0.2)
                buttonGradient.Color = ColorSequence.new{
                    ColorSequenceKeypoint.new(0, Color3.new(0.9, 0.3, 0.3)),
                    ColorSequenceKeypoint.new(1, Color3.new(0.7, 0.1, 0.1))
                }
            else
                button.Text = "👁️ Invisible (OFF)"
                button.BackgroundColor3 = Color3.new(0.2, 0.4, 0.8)
                buttonGradient.Color = ColorSequence.new{
                    ColorSequenceKeypoint.new(0, Color3.new(0.3, 0.5, 0.9)),
                    ColorSequenceKeypoint.new(1, Color3.new(0.1, 0.3, 0.7))
                }
            end
            animateButton("click")
        end
    end)

    return button
end

-- Функция для Noclip (сохранена)
local function createNoclipButton()
    local noclipButton = Instance.new("TextButton")
    noclipButton.Size = UDim2.new(1, -40, 0, 25)
    noclipButton.Position = UDim2.new(0, 10, 0, 35)
    noclipButton.BackgroundColor3 = Color3.new(0.2, 0.8, 0.2)
    noclipButton.BorderSizePixel = 0
    noclipButton.Text = "🚶 Noclip (OFF)"
    noclipButton.TextColor3 = Color3.new(1, 1, 1)
    noclipButton.TextScaled = true
    noclipButton.Font = Enum.Font.GothamBold
    noclipButton.Parent = mainFrame

    local noclipCorner = Instance.new("UICorner")
    noclipCorner.CornerRadius = UDim.new(0, 8)
    noclipCorner.Parent = noclipButton

    local noclipGradient = Instance.new("UIGradient")
    noclipGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.new(0.3, 0.9, 0.3)),
        ColorSequenceKeypoint.new(1, Color3.new(0.1, 0.7, 0.1))
    }
    noclipGradient.Rotation = 90
    noclipGradient.Parent = noclipButton

    local function animateNoclipButton(action)
        if action == "click" then
            TweenService:Create(noclipButton, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.InOut), {Size = UDim2.new(1, -45, 0, 20)}):Play()
            wait(0.1)
            TweenService:Create(noclipButton, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(1, -40, 0, 25)}):Play()
        end
    end

    local function applyNoclip(character)
        if not character then return end
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    noclipButton.MouseButton1Click:Connect(function()
        local character = player.Character
        if character then
            isNoclip = not isNoclip
            if isNoclip then
                noclipConnection = RunService.Heartbeat:Connect(function()
                    applyNoclip(character)
                end)
                noclipButton.Text = "🚫 Noclip (ON)"
                noclipButton.BackgroundColor3 = Color3.new(0.8, 0.8, 0.2)
                noclipGradient.Color = ColorSequence.new{
                    ColorSequenceKeypoint.new(0, Color3.new(0.9, 0.9, 0.3)),
                    ColorSequenceKeypoint.new(1, Color3.new(0.7, 0.7, 0.1))
                }
            else
                if noclipConnection then
                    noclipConnection:Disconnect()
                    noclipConnection = nil
                end
                for _, part in pairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
                noclipButton.Text = "🚶 Noclip (OFF)"
                noclipButton.BackgroundColor3 = Color3.new(0.2, 0.8, 0.2)
                noclipGradient.Color = ColorSequence.new{
                    ColorSequenceKeypoint.new(0, Color3.new(0.3, 0.9, 0.3)),
                    ColorSequenceKeypoint.new(1, Color3.new(0.1, 0.7, 0.1))
                }
            end
            animateNoclipButton("click")
        end
    end)

    return noclipButton
end

