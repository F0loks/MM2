-- При respawn применяем состояния (без авто-прозрачности, если false)
player.CharacterAdded:Connect(function(character)
    wait(1)
    if isInvisible then  -- Только если включено вручную
        local targetTransparency = 0.7
        local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                local tween = TweenService:Create(part, tweenInfo, {Transparency = targetTransparency})
                tween:Play()
            elseif part:IsA("Decal") then
                local tween = TweenService:Create(part, tweenInfo, {Transparency = targetTransparency})
                tween:Play()
            end
        end
    end
    if isNoclip then
        if noclipConnection then noclipConnection:Disconnect() end
        noclipConnection = RunService.Heartbeat:Connect(function()
            local currentChar = player.Character
            if currentChar then
                for _, part in pairs(currentChar:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
    if isAutoFarm then
        if autoFarmConnection then autoFarmConnection:Disconnect() end
        autoFarmConnection = RunService.Heartbeat:Connect(function()
            autoFarmLoop()
        end)
    end
end)

